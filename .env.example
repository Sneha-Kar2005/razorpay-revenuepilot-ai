# ============================================================================
# RevenuePilot AI — environment configuration
# Copy this file to backend/.env and fill in real values to enable live
# integrations. Everything works without any of these values set: the system
# runs in DEMO/SYNTHETIC mode with deterministic simulated data and a
# rule-based AI fallback, clearly labelled as such in the UI and audit trail.
# ============================================================================

# --- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Database -----------------------------------------------------------------
# SQLite file used for local/demo persistence.
DATABASE_URL="file:./dev.db"

# --- Razorpay (TEST MODE) ----------------------------------------------------
# Leave blank to run in DEMO/SYNTHETIC mode. When both key id/secret are set,
# the system uses the real Razorpay Node SDK against api.razorpay.com in TEST
# mode (test keys start with rzp_test_). Get test keys from:
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret configured in Dashboard > Webhooks. Required to verify
# X-Razorpay-Signature on inbound webhook calls (HMAC-SHA256 over raw body).
RAZORPAY_WEBHOOK_SECRET=

# --- AI Provider (Anthropic Claude) -----------------------------------------
# Leave blank to use the deterministic SIMULATED reasoning engine (clearly
# labelled in the UI/audit trail as "Simulated AI - no API key configured").
# When set, root-cause analysis, strategy explanation and message drafting
# use the real Claude API with structured/validated JSON output.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Policy thresholds (paise) -----------------------------------------------
POLICY_MAX_RETRIES=2
POLICY_MIN_COOLDOWN_HOURS=4
POLICY_MAX_AUTO_RECOVERY_PAISE=5000000
POLICY_APPROVAL_THRESHOLD_PAISE=5000000

# --- Demo seed ---------------------------------------------------------------
DEMO_SEED=revenuepilot-2026
DEMO_CASE_COUNT=120
